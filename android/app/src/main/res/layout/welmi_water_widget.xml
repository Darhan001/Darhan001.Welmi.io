<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-разметка виджета «Вода» (только TextView/ProgressBar/ImageButton) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welmi_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💧 Вода"
            android:textColor="#1B1B1B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_add_water"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/welmi_add_btn"
            android:contentDescription="Выпить стакан"
            android:padding="8dp"
            android:src="@android:drawable/ic_input_add"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/water_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 / 2000 мл"
        android:textColor="#1B1B1B"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/water_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:max="2000"
        android:progress="0"
        android:progressDrawable="@drawable/welmi_progress" />

    <TextView
        android:id="@+id/calories_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 / 2000 ккал"
        android:textColor="#666666"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/calories_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="2000"
        android:progress="0"
        android:progressDrawable="@drawable/welmi_progress" />

</LinearLayout>
